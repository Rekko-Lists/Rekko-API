# ==========    SERVER    ==========
APP_URL_DEV="http://localhost"
APP_URL_PROD="https://your-api-domain.up.railway.app"
SERVER_PORT=5000
NODE_ENV="development"

# ==========    CLIENT    ==========
CLIENT_URL_DEV="http://localhost"
CLIENT_URL_PROD="https://your-frontend.vercel.app"
CLIENT_PORT=5173
CLIENT_PATH_RESET_PASSWORD="/user/resetpassword"

# ==========    BCRYPT    ==========
SALT_ROUNDS=10

# ==========    MAILER    ==========
# Opcion recomendada en produccion (gratis, 300 emails/dia, va por HTTPS asi
# que funciona aunque Railway bloquee SMTP). Crea cuenta en brevo.com, verifica
# tu email como sender (Settings -> Senders) y genera una API key (SMTP & API).
# Si BREVO_API_KEY esta definida se usa Brevo y se ignora el SMTP de abajo.
BREVO_API_KEY=""

# ==========  NODEMAILER (fallback SMTP, p. ej. dev local)  ==========
MAIL_HOST="smtp.gmail.com"
# 465 (TLS implicito) recomendado en produccion/Railway; 587 (STARTTLS) suele
# fallar o estar bloqueado en algunos hosts. El codigo deriva `secure` del puerto.
MAIL_PORT=465
MAIL_USER="your-email@gmail.com"
# Con Gmail: contraseña de aplicacion (requiere 2FA activado en la cuenta),
# NO la contraseña normal de la cuenta.
MAIL_PASS="your-gmail-app-password"
# Con Gmail el From DEBE ser la misma cuenta autenticada (o un alias registrado
# en "Enviar como"); si no, Gmail lo reescribe o rechaza el envio (553-5.7.1).
# Si se deja vacio se usa '"Rekko" <MAIL_USER>' automaticamente.
MAIL_FROM=""

# ========== JSONWEBTOKEN ==========
JWT_SECRET="generate-a-strong-random-secret"
REFRESH_TOKEN_SECRET="generate-another-strong-random-secret"

# ==========   DATABASE   ==========
DATABASE_URL="postgresql://user:password@host:5432/database"

# ==========   FIREBASE   ==========
# Local dev: path to the JSON file on disk
FIREBASE_SERVICE_ACCOUNT_KEY="./serviceAccountKey.json"
# Production (Railway): paste the entire serviceAccountKey.json content as a single-line JSON string
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID="your-firebase-project-id"

# ==========  DISCORDENV  ==========
DISCORD_CLIENT_ID_DEV="your-discord-dev-app-client-id"
DISCORD_CLIENT_ID_PROD="your-discord-prod-app-client-id"
DISCORD_SECRET_ID_DEV="your-discord-dev-app-secret"
DISCORD_SECRET_ID_PROD="your-discord-prod-app-secret"
DISCORD_REDIRECT_URI_DEV="http://localhost:5173"
DISCORD_REDIRECT_URI_PROD="https://your-frontend.vercel.app"
DISCORD_PATH_CALLBACK="/oauth/discord/callback"

# ==========  CLOUDINARY  ==========
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==========   IMAGES    ==========
DEFAULT_PROFILE_IMAGE_URL=""
DEFAULT_BANNER_IMAGE_URL=""
DEFAULT_BACKGROUND_IMAGE_URL=""

# ==========   MAL   ==========
MAL_CLIENT_ID=tu-client-id-de-mal
MAL_CLIENT_SECRET=tu-client-secret-de-mal
MAL_TOKEN_STORE_PATH=/app/.mal-token.json