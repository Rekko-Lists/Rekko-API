generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RefreshToken {
  refreshTokenId Int       @id @default(autoincrement()) @map("refresh_token_id")
  userId         Int       @map("user_id")
  token          String
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  userAgent      String    @map("user_agent")
  ip             String
  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("refresh_token")
}

model OAuthAccount {
  oauthAccountId Int    @id @default(autoincrement()) @map("oauth_account_id")
  userId         Int    @map("user_id")
  providerUserId String @map("provider_user_id")
  provider       String
  user           User   @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_account")
}

model Comment {
  commentId       Int               @id @default(autoincrement()) @map("comment_id")
  userId          Int?              @map("user_id")
  postId          Int               @map("post_id")
  parentCommentId Int?              @map("parent_comment_id")
  message         String
  likes           Int
  parentComment   Comment?          @relation("CommentReplies", fields: [parentCommentId], references: [commentId], onDelete: Cascade)
  replies         Comment[]         @relation("CommentReplies")
  post            Post              @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [userId])
  userLikeComment UserLikeComment[]

  @@map("comment")
}

model User {
  userId                  Int                       @id @default(autoincrement()) @map("user_id")
  email                   String                    @unique
  password                String
  username                String                    @unique
  profileImage            String                    @map("profile_image")
  bannerImage             String?                   @map("banner_image")
  backgroundImage         String?                   @map("background_image")
  role                    UserRole                  @default(USER)
  createdAt               DateTime                  @default(now()) @map("created_at")
  biography               String?
  reputation              Int                       @default(0)
  emailVerified           Boolean                   @default(false) @map("email_verified")
  backgroundImagePublicId String?                   @map("background_image_public_id")
  bannerImagePublicId     String?                   @map("banner_image_public_id")
  profileImagePublicId    String?                   @map("profile_image_public_id")
  updatedAt               DateTime                  @default(now()) @updatedAt @map("updated_at")
  streak                  Int                       @default(0) @map("streak")
  streakUpdatedAt         DateTime?                 @map("streak_updated_at")
  comments                Comment[]
  emailRequest            EmailChangeRequest?       @relation("UserEmailChangeRequest")
  verificationRequest     EmailVerificationRequest? @relation("UserEmailVerification")
  oauthAccounts           OAuthAccount[]
  passwordRequest         PasswordChangeRequest?    @relation("UserPasswordChangeRequest")
  posts                   Post[]
  refreshTokens           RefreshToken[]
  userLikeAnime           UserLikeAnime[]
  userLikeComment         UserLikeComment[]
  userLikePost            UserLikePost[]
  userRateAnime           UserRateAnime[]
  userSocialAccount       UserSocialAccount[]
  userWatchAnime          UserWatchAnime[]

  @@index([reputation])
  @@map("user")
}

model SocialAccount {
  socialAccountId   Int                 @id @default(autoincrement()) @map("social_account_id")
  name              String              @unique
  userSocialAccount UserSocialAccount[]

  @@map("social_account")
}

model Post {
  postId       Int            @id @default(autoincrement()) @map("post_id")
  userId       Int?           @map("user_id")
  title        String
  description  String?
  photo        String?
  likes        Int
  createdAt    DateTime       @default(now()) @map("created_at")
  animes       AnimePost[]
  comments     Comment[]
  user         User?          @relation(fields: [userId], references: [userId])
  userLikePost UserLikePost[]

  @@map("post")
}

model Anime {
  animeId             Int                       @id @default(autoincrement()) @map("anime_id")
  malId               Int                       @unique @map("mal_id")
  broadcastId         Int                       @unique @map("broadcast_id")
  name                String                    @unique
  synopsis            String
  imgMedium           String                    @map("img_medium")
  imgLarge            String                    @map("img_large")
  startDate           DateTime                  @map("start_date")
  endDate             DateTime                  @map("end_date")
  malMean             Float                     @map("mal_mean")
  malRank             Int                       @map("mal_rank")
  mean                Float
  numEpisodes         Int                       @map("num_episodes")
  status              String
  nextUpdate          DateTime                  @map("next_update")
  likes               Int
  studios             String[]
  mediaType           String                    @default("tv") @map("media_type")
  duration            Int?                      @map("duration")
  premieredSeason     String?                   @map("premiered_season")
  premieredYear       Int?                      @map("premiered_year")
  rating              String?                   @map("rating")
  members             Int                       @default(0)
  broadcast           Broadcast                 @relation(fields: [broadcastId], references: [broadcastId])
  animeGenres         AnimeGenre[]
  animes              AnimePost[]
  postRecommendations AnimePostRecommendation[] @relation("AnimePostRecommendationSource")
  postRecommendedBy   AnimePostRecommendation[] @relation("AnimePostRecommendationTarget")
  relations           AnimeRelation[]           @relation("AnimeRelationSource")
  relatedFrom         AnimeRelation[]           @relation("AnimeRelationTarget")
  challenges          Challenge[]
  userLikeAnime       UserLikeAnime[]
  userRateAnime       UserRateAnime[]
  userWatchAnime      UserWatchAnime[]
  weeklyActivity      AnimeWeeklyActivity[]

  @@map("anime")
}

model AnimeWeeklyActivity {
  animeWeeklyActivityId Int      @id @default(autoincrement()) @map("anime_weekly_activity_id")
  animeId               Int      @map("anime_id")
  weekStart             DateTime @map("week_start")
  postCount             Int      @default(0) @map("post_count")
  animeLikeCount        Int      @default(0) @map("anime_like_count")
  score                 Int      @default(0)
  anime                 Anime    @relation(fields: [animeId], references: [animeId], onDelete: Cascade)

  @@unique([animeId, weekStart])
  @@index([weekStart, score])
  @@map("anime_weekly_activity")
}

model AnimeRelation {
  animeRelationId Int      @id @default(autoincrement()) @map("anime_relation_id")
  animeId         Int      @map("anime_id")
  relatedMalId    Int      @map("related_mal_id")
  relatedAnimeId  Int?     @map("related_anime_id")
  relationType    String   @map("relation_type")
  relationLabel   String   @map("relation_label")
  relatedTitle    String   @map("related_title")
  relatedImage    String?  @map("related_image")
  createdAt       DateTime @default(now()) @map("created_at")
  anime           Anime    @relation("AnimeRelationSource", fields: [animeId], references: [animeId], onDelete: Cascade)
  relatedAnime    Anime?   @relation("AnimeRelationTarget", fields: [relatedAnimeId], references: [animeId])

  @@unique([animeId, relatedMalId])
  @@map("anime_relation")
}

model Genre {
  genreId     Int          @id @default(autoincrement()) @map("genre_id")
  name        String       @unique
  animeGenres AnimeGenre[]

  @@map("genre")
}

model AnimeGenre {
  animeGenreId Int   @id @default(autoincrement()) @map("anime_genre_id")
  animeId      Int   @map("anime_id")
  genreId      Int   @map("genre_id")
  anime        Anime @relation(fields: [animeId], references: [animeId], onDelete: Cascade)
  genre        Genre @relation(fields: [genreId], references: [genreId], onDelete: Cascade)

  @@unique([animeId, genreId])
  @@map("anime_genre")
}

model Broadcast {
  broadcastId Int    @id @default(autoincrement()) @map("broadcast_id")
  dayOfWeek   String @map("day_of_week")
  startTime   String @map("start_time")
  anime       Anime?

  @@map("broadcast")
}

model Challenge {
  challengeId Int   @id @default(autoincrement()) @map("challenge_id")
  typeId      Int   @map("type_id")
  dayId       Int   @map("day_id")
  animeId     Int   @map("anime_id")
  data        Json
  anime       Anime @relation(fields: [animeId], references: [animeId])
  day         Day   @relation(fields: [dayId], references: [dayId])
  type        Type  @relation(fields: [typeId], references: [typeId])

  @@unique([dayId, typeId])
  @@map("challenge")
}

model Type {
  typeId     Int         @id @default(autoincrement()) @map("type_id")
  name       TypeName    @unique
  challenges Challenge[]

  @@map("type")
}

model Day {
  dayId      Int         @id @default(autoincrement()) @map("day_id")
  date       String      @unique
  challenges Challenge[]

  @@map("day")
}

model UserLikePost {
  userLikePostId Int      @id @default(autoincrement()) @map("user_like_post_id")
  userId         Int      @map("user_id")
  postId         Int      @map("post_id")
  createdAt      DateTime @default(now()) @map("created_at")
  post           Post     @relation(fields: [postId], references: [postId], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([createdAt, postId])
  @@map("user_like_post")
}

model UserLikeComment {
  userLikeCommentId Int     @id @default(autoincrement()) @map("user_like_comment_id")
  userId            Int     @map("user_id")
  commentId         Int     @map("comment_id")
  comment           Comment @relation(fields: [commentId], references: [commentId], onDelete: Cascade)
  user              User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("user_like_comment")
}

model AnimePost {
  animePostId Int   @id @default(autoincrement()) @map("anime_post_id")
  animeId     Int   @map("anime_id")
  postId      Int   @map("post_id")
  anime       Anime @relation(fields: [animeId], references: [animeId], onDelete: Cascade)
  post        Post  @relation(fields: [postId], references: [postId], onDelete: Cascade)

  @@unique([animeId, postId])
  @@map("anime_post")
}

model AnimePostRecommendation {
  animePostRecommendationId Int      @id @default(autoincrement()) @map("anime_post_recommendation_id")
  animeId                   Int      @map("anime_id")
  relatedAnimeId            Int      @map("related_anime_id")
  relationCount             Int      @default(0) @map("relation_count")
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at")
  anime                     Anime    @relation("AnimePostRecommendationSource", fields: [animeId], references: [animeId], onDelete: Cascade)
  relatedAnime              Anime    @relation("AnimePostRecommendationTarget", fields: [relatedAnimeId], references: [animeId], onDelete: Cascade)

  @@unique([animeId, relatedAnimeId])
  @@index([animeId, relationCount])
  @@map("anime_post_recommendation")
}

model UserLikeAnime {
  userLikeAnimeId Int      @id @default(autoincrement()) @map("user_like_anime_id")
  userId          Int      @map("user_id")
  animeId         Int      @map("anime_id")
  createdAt       DateTime @default(now()) @map("created_at")
  anime           Anime    @relation(fields: [animeId], references: [animeId], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, animeId])
  @@index([createdAt, animeId])
  @@map("user_like_anime")
}

model UserRateAnime {
  userRateAnimeId Int   @id @default(autoincrement()) @map("user_rate_anime_id")
  userId          Int   @map("user_id")
  animeId         Int   @map("anime_id")
  rate            Int
  anime           Anime @relation(fields: [animeId], references: [animeId], onDelete: Cascade)
  user            User  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, animeId])
  @@map("user_rate_anime")
}

model UserWatchAnime {
  userWatchAnimeId Int        @id @default(autoincrement()) @map("user_watch_anime_id")
  userId           Int        @map("user_id")
  animeId          Int        @map("anime_id")
  numEpisodes      Int        @map("num_episodes")
  state            AnimeState
  anime            Anime      @relation(fields: [animeId], references: [animeId], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, animeId])
  @@map("user_watch_anime")
}

model UserSocialAccount {
  userSocialAccountId Int           @id @default(autoincrement()) @map("user_social_account_id")
  userId              Int           @map("user_id")
  socialAccountId     Int           @map("social_account_id")
  socialUrl           String        @map("social_url")
  socialAccount       SocialAccount @relation(fields: [socialAccountId], references: [socialAccountId])
  user                User          @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, socialAccountId])
  @@map("user_social_account")
}

model EmailChangeRequest {
  emailChangeRequestId Int      @id @default(autoincrement()) @map("email_change_request_id")
  userId               Int      @unique @map("user_id")
  newEmail             String   @unique
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  confirmed            Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 User     @relation("UserEmailChangeRequest", fields: [userId], references: [userId], onDelete: Cascade)

  @@map("email_change_request")
}

model PasswordChangeRequest {
  passwordChangeRequestId Int      @id @default(autoincrement()) @map("password_change_request_id")
  userId                  Int      @unique @map("user_id")
  token                   String   @unique
  expiresAt               DateTime @map("expires_at")
  confirmed               Boolean  @default(false)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation("UserPasswordChangeRequest", fields: [userId], references: [userId], onDelete: Cascade)

  @@map("password_change_request")
}

model EmailVerificationRequest {
  emailVerificationRequestId Int      @id @default(autoincrement()) @map("email_verification_request_id")
  userId                     Int      @unique @map("user_id")
  token                      String   @unique
  expiresAt                  DateTime @map("expires_at")
  createdAt                  DateTime @default(now()) @map("created_at")
  confirmed                  Boolean  @default(false)
  updatedAt                  DateTime @updatedAt @map("updated_at")
  user                       User     @relation("UserEmailVerification", fields: [userId], references: [userId], onDelete: Cascade)

  @@map("email_verification_request")
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum AnimeState {
  COMPLETED
  WATCHING
  ON_HOLD
  DROPPED
  PLAN_TO_WATCH
}

enum TypeName {
  ANIME
  CHARACTER
  OPENING
  EMOJI
}
